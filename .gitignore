.env
.env.*
__pycache__/
*.pyc
.ipynb_checkpoints/

# Datos pesados regenerables.
# Se excluyen del control de versiones porque se
# reconstruyen con los scripts; los manifiestos, reportes y figuras SI se versionan.
# outputs/rasters/          -> ~244 MB, se regenera con descargar_rasters.py --download
# outputs/parte2/data/pixels/ -> ~80-130 MB, se regenera con preparar_dataset_ml.py --build

outputs/rasters/
outputs/parte2/data/pixels/
outputs/parte1_real/logs/
outputs/parte2/logs/
outputs/logs/

# Muestra EDA (9 MB) y temporales: regenerables con --build
outputs/parte2/data/eda_sample.parquet
outputs/parte2/**/*.tmp
outputs/parte2/**/*.tmp.parquet

# Artefactos del perfil smoke: NO entregables
outputs/parte2/smoke/
outputs/parte2/models/
outputs/parte2/splits/

# Ejercicios 8-10: GeoTIFF predictivos, Parquet OOF, SHAP completo y modelos
outputs/parte2/maps/probability/**/*.tif
outputs/parte2/maps/errors_oof/**/*.tif
outputs/parte2/maps/errors_oof/pixels/
outputs/parte2/interpretability/shap_values_*.npy
outputs/parte2/**/*.joblib
